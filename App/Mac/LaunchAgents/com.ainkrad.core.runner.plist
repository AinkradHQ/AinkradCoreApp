<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The runner inside the app, started at login by SMAppService (MacRunnerControl). Terminals are off in this one;
	     com.ainkrad.core.runner.terminals.plist differs only in --enable-pty. A plist cannot change after signing, so the
	     "Terminals on this Mac" switch registers one or the other. No --state: the runner's default is
	     $HOME/.ainkrad-runner/core, and a plist cannot know the home folder. -->
	<key>Label</key>
	<string>com.ainkrad.core.runner</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/ainkrad-runner</string>
	<key>ProgramArguments</key>
	<array>
		<string>ainkrad-runner</string>
		<string>connect</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<!-- Terminals outlive the runner: each is a detached ainkrad-ptyhost. -->
	<key>AbandonProcessGroup</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Nice</key>
	<integer>5</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>20</integer>
</dict>
</plist>
